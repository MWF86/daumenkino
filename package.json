{
  "name": "daumenkino",
  "productName": "Daumenkino",
  "version": "1.1.13",
  "description": "Karussells für Instagram bauen. Ohne Konto, ohne Cloud.",
  "main": "main.js",
  "author": {
    "name": "Moritz Fingerle"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bauen.js neutral --nur-vorbereiten && electron .",
    "bau:mac": "node bauen.js neutral mac",
    "bau:win": "node bauen.js neutral win",
    "bau:linux": "node bauen.js neutral linux"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "de.moritzfingerle.daumenkino",
    "productName": "Daumenkino",
    "directories": {
      "output": "fertig"
    },
    "files": [
      "main.js",
      "preload.js",
      "fassung.json",
      "app/**/*",
      "icons/**/*"
    ],
    "mac": {
      "icon": "icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MWF86",
        "repo": "daumenkino",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MWF86/daumenkino.git"
  }
}
